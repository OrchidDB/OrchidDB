<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.orchiddb</groupId>
  <artifactId>orchiddb-parent</artifactId>
  <version>0.4.0</version>
  <name>OrchidDB Java</name>
  <description>Graph queries over caller-owned SQL engines</description>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <arrow.version>18.3.0</arrow.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <orchiddb.native.path>${maven.multiModuleProjectDirectory}/../../target/debug/liborchiddb_java.dylib</orchiddb.native.path>
    <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>
    <release.artifacts>${maven.multiModuleProjectDirectory}/target/native-artifacts</release.artifacts>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.24.0</version>
            </googleJavaFormat>
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>OrchidDB needs Java 17 or newer. Set JAVA_HOME to a supported JDK.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <orchiddb.native.path>${orchiddb.native.path}</orchiddb.native.path>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doclint>all,-missing</doclint>
        </configuration>
        <executions>
          <execution>
            <id>javadoc</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <packaging>pom</packaging>
  <url>https://orchiddb.com</url>
  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://github.com/OrchidDB/OrchidDB/blob/main/LICENSE.md</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>henneberger</id>
      <name>Daniel Henneberger</name>
      <url>https://github.com/henneberger</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/OrchidDB/OrchidDB</url>
    <connection>scm:git:https://github.com/OrchidDB/OrchidDB.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/OrchidDB/OrchidDB.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <modules>
    <module>orchiddb-java</module>
  </modules>
  <profiles>
    <profile>
      <id>gremlin</id>
      <modules>
        <module>orchiddb-gremlin</module>
      </modules>
    </profile>
  </profiles>
</project>
