--- query
MATCH (n:thing) RETURN n
--- setup_statements
# re-extracted from kuzu test/test_files/issue/issue.test case 2376
MATCH (n) DELETE n
MERGE (n:thing {name: 'original'})
MATCH (n:thing {name: 'original'}) SET n.name = 'rename 1x' RETURN n
MATCH (n:thing {name: 'rename 1x'}) SET n.name = 'rename 2x' RETURN n
CREATE (n:thing {name: 'original'})
CREATE (n:thing {name: 'rename 1x'})
CREATE (n:thing {name: 'rename 2x'})
MATCH (n:thing) WHERE n.name='rename 1x' DELETE n
