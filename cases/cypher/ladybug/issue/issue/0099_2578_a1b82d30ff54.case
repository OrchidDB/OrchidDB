--- query
WITH NULL as parentid MATCH p = (t1:T)<-[e:CHILD_OF*0..1]-(t0:T) WHERE CASE WHEN parentid IS NULL THEN NOT EXISTS {MATCH (t1)-[:CHILD_OF]->(:T)} ELSE EXISTS {MATCH (t1)-[:CHILD_OF]->(:T {id: parentid})} END AND (NOT EXISTS {MATCH (:T)-[:CHILD_OF]->(t0)} OR length(e) = 1) RETURN properties(nodes(p),'id')
