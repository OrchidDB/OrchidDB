--- query
MATCH p = (a:person)-[e:knows*2..2 (r, n | WHERE n.fName = 'Dan' AND r.date > date("1999-01-01"))]->(b:person)  WHERE a.ID = 0 RETURN properties(nodes(p), 'fName'), properties(rels(p), 'date')
