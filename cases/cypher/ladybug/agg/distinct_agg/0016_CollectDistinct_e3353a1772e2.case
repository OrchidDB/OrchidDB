--- query
UNWIND [1,1] AS x MATCH (a:person)-[e:knows]->() WHERE a.ID = 5 MATCH (b:person) WHERE b.ID < 6 AND b.ID > 2 WITH e, COLLECT(DISTINCT b) AS bs UNWIND bs AS newB RETURN e.date, newB.fName
