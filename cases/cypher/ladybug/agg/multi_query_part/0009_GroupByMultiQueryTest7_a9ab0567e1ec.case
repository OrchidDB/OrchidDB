--- query
MATCH (a:person)-[r1:knows]->(b:person)-[r2:knows]->(c:person) WITH count(r1) AS numFollowers, c, b, r2 WHERE b.age >= 0 AND b.age <= 30 AND numFollowers > 0 RETURN b.fName, c.fName, numFollowers
