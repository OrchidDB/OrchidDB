--- query
MATCH (n)-[:LivesIn]->(:City) WITH collect(n.name) AS names MATCH p = (u:User {name: "Adam"})-[e:Follows*]->(u2:User {name: "Noura"}) WHERE size(list_filter(properties(nodes(e),'name'), x->x IN names)) > 0 RETURN properties(nodes(p),'name')
--- expected
[Adam,Karissa,Zhang,Noura]
[Adam,Zhang,Noura]
