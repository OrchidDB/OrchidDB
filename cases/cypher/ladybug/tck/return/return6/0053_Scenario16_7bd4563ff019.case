{"dataset":"CSV tck","expected_kind":"rows","id":"cypher.ladybug.tck.return.return6.Scenario16.7bd4563ff019","language":"cypher","ordered":true,"source":"tck/return/return6.test","source_case":"Scenario16","source_log":null,"status":"imported","suite":"ladybug","version":1}
--- query
MATCH (me)-[r1:ATE]->()<-[r2:ATE]-(you) WHERE me.name = 'Michael' WITH me, count(DISTINCT r1) AS H1, count(DISTINCT r2) AS H2, you MATCH (me)-[r1:ATE]->()<-[r2:ATE]-(you) RETURN me, you, sum((1 - abs(r1.times / H1 - r2.times / H2)) * (r1.times + r2.times) / (H1 + H2)) AS sum
--- graph_initializer
node andres:N {name: "Andres"}
node michael:N {name: "Michael"}
node peter:N {name: "Peter"}
node bread:N {type: "Bread"}
node veggies:N {type: "Veggies"}
node meat:N {type: "Meat"}
edge andres -[:ATE {times: 10}]-> bread
edge andres -[:ATE {times: 8}]-> veggies
edge michael -[:ATE {times: 4}]-> veggies
edge michael -[:ATE {times: 6}]-> bread
edge michael -[:ATE {times: 9}]-> meat
edge peter -[:ATE {times: 7}]-> veggies
edge peter -[:ATE {times: 7}]-> bread
edge peter -[:ATE {times: 4}]-> meat
