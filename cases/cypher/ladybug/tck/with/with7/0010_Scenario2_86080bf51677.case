--- query
MATCH (david {name: 'David'})--(otherPerson)-->() WITH otherPerson, count(*) AS foaf WHERE foaf > 1 WITH otherPerson WHERE otherPerson.name <> 'NotOther' RETURN count(*)
--- graph_initializer
