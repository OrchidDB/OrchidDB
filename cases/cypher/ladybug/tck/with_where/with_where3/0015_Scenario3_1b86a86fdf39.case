--- query
MATCH (n)-[rel]->(x) WITH n, x WHERE n.animal = x.animal RETURN n, x
--- graph_initializer
node a:A {animal: "monkey"}
node b:B {animal: "cow"}
node c:C {animal: "monkey"}
node d:D {animal: "cow"}
edge a -[:KNOWS]-> b
edge a -[:KNOWS]-> c
edge d -[:KNOWS]-> b
edge d -[:KNOWS]-> c
--- expected
(:A {animal: 'monkey'})|(:C {animal: 'monkey'})
(:D {animal: 'cow'})|(:B {animal: 'cow'})
