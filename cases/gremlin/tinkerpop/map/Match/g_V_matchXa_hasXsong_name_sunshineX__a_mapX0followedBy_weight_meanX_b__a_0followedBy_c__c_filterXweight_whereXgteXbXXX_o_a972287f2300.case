--- query
g.V().match(__.as("a").has("song", "name", "HERE COMES SUNSHINE"),
__.as("a").map(__.inE("followedBy").values("weight").mean()).as("b"),
__.as("a").inE("followedBy").as("c"),
__.as("c").filter(__.values("weight").where(P.gte("b"))).outV().as("d")).
select("d").by("name")
