shortestPath().
with("~tinkerpop.shortestPath.target", __.has("song","name","MAYBE YOU KNOW HOW I FEEL")).
with("~tinkerpop.shortestPath.edges", __.outE("followedBy")).
with("~tinkerpop.shortestPath.distance", "weight")
